        if current > pending.Before then
            CraftQualityList.Pending = nil
            if pending.Key == "MythicalScroll" or pending.Key == "LegendaryScroll" then
                local pendingLabel = CraftQualityList.GetLabel(pending.Key) or pending.Key
                if bothSelected and pending.Key == "MythicalScroll"
                    and CraftQualityList.UnlockStage ~= "Legendary" then
                    CraftQualityList.UnlockStage = "Legendary"
                    CraftStatus = TranslateStatus(pendingLabel .. ": fabricado; continuando con Legendary Scroll")
                    return
                end
