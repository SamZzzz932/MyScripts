    local DracoAuraHooked = false
    local DracoAuraQueue, DracoAuraQueued = {}, {}
    local DracoAuraProcessing = false
    local DracoAuraScanning = false
    local DracoHidden = setmetatable({}, { __mode = "k" })
    local DracoAuraBodyParts = {
        Head = true,
        Torso = true,
        HumanoidRootPart = true,
        UpperTorso = true,
        LowerTorso = true,
        LeftUpperArm = true,
        LeftLowerArm = true,
        LeftHand = true,
        RightUpperArm = true,
        RightLowerArm = true,
        RightHand = true,
        LeftUpperLeg = true,
        LeftLowerLeg = true,
        LeftFoot = true,
        RightUpperLeg = true,
        RightLowerLeg = true,
        RightFoot = true,
    }
    local DracoAuraKeywords = {
        "aura", "domain", "field", "sphere", "dome", "orb",
        "vfx", "effect", "spark", "symbol", "ring", "circle",
        "ember", "flame", "fire", "smoke", "glow", "particle",
    }
    local function DracoNormalizeName(name)
        return tostring(name):lower():gsub("[%s_%-%./:]", "")
    end
    local function IsDracoName(name)
        return DracoNormalizeName(name):find("draco", 1, true) ~= nil
    end
    local function HasDracoKeyword(name)
        local n = DracoNormalizeName(name)
        for _, key in ipairs(DracoAuraKeywords) do
            if n:find(key, 1, true) then
                return true
            end
        end
        return false
    end
    local function IsHornWingTail(name)
        local n = DracoNormalizeName(name)
        return n:find("horn", 1, true) ~= nil
            or n:find("wing", 1, true) ~= nil
            or n:find("tail", 1, true) ~= nil
    end
    local function InHornWingTail(obj)
        local node = obj
        for _ = 1, 6 do
            if not node then return false end
            if IsHornWingTail(node.Name) then return true end
            node = node.Parent
        end
        return false
    end
    local function HasDracoAncestor(obj)
        local node = obj
        for _ = 1, 16 do
            if not node then return false end
            if node:IsA("Model") and Players:GetPlayerFromCharacter(node) then
                return false
            end
            if IsDracoName(node.Name) then
                return true
            end
            node = node.Parent
        end
        return false
    end
    local function FindDracoCharacter(obj)
        local node = obj
        for _ = 1, 16 do
            if not node then return nil end
            if node:IsA("Model") and Players:GetPlayerFromCharacter(node) then
                return node
            end
            node = node.Parent
        end
        return nil
    end
    local function HasDracoV4Marker(char)
        if not char then return false end
        return char:FindFirstChild("DracoV4", true) ~= nil
            or char:FindFirstChild("DracoHornsB", true) ~= nil
            or char:FindFirstChild("DracoTail", true) ~= nil
            or char:FindFirstChild("DracoV4Aura", true) ~= nil
            or char:FindFirstChild("DracoAura", true) ~= nil
    end
    local function IsOrangeAuraPart(obj)
        if not obj:IsA("BasePart") then return false end
        if DracoAuraBodyParts[obj.Name] or InHornWingTail(obj) then return false end
        local size = obj.Size
        if math.max(size.X, size.Y, size.Z) < 12 then return false end
        if obj.Transparency >= 0.98 then return false end
        local color = obj.Color
        return color.R >= 0.55 and color.G >= 0.15 and color.G <= 0.8 and color.B <= 0.45
    end
    local function IsLooseAuraPart(obj)
        if not obj:IsA("BasePart") then return false end
        if DracoAuraBodyParts[obj.Name] or InHornWingTail(obj) then return false end
        local size = obj.Size
        if math.max(size.X, size.Y, size.Z) < 12 then return false end
        return obj.Transparency < 0.98 and (obj.Transparency >= 0.2 or obj.Material == Enum.Material.Neon)
    end
    local function IsAuraLikePart(obj)
        return IsOrangeAuraPart(obj) or IsLooseAuraPart(obj)
    end
    local function IsInsideAuraObject(obj, allowLoose)
        local node = obj and obj.Parent
        for _ = 1, 8 do
            if not node then return false end
            if IsOrangeAuraPart(node) or (allowLoose and IsLooseAuraPart(node)) then
                return true
            end
            node = node.Parent
        end
        return false
    end
    local function HasActiveDracoAura(char)
        if not char or not HasDracoV4Marker(char) then return false end
        for _, obj in ipairs(char:GetDescendants()) do
            if IsAuraLikePart(obj) then return true end
        end
        return false
    end
    local function IsAuraVisualEffect(obj)
        return obj:IsA("ParticleEmitter") or obj:IsA("Sparkles")
            or obj:IsA("Beam") or obj:IsA("Trail")
            or obj:IsA("Fire") or obj:IsA("Smoke")
            or obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight")
            or obj:IsA("Highlight")
    end
    local function ShouldHideDracoObject(obj, aggressive)
        if not obj or not obj.Parent then return false end
        local dracoRelated = HasDracoAncestor(obj)
        if obj:IsA("BasePart") then
            if DracoAuraBodyParts[obj.Name] or InHornWingTail(obj) then return false end
            if dracoRelated then return true end
            if aggressive and HasDracoKeyword(obj.Name) then return true end
            if aggressive and IsAuraLikePart(obj) then return true end
            return false
        end
        if IsAuraVisualEffect(obj) then
            return dracoRelated or IsInsideAuraObject(obj, aggressive)
                or (aggressive and HasDracoKeyword(obj.Name))
        end
        if obj:IsA("Decal") or obj:IsA("Texture") then
            return dracoRelated or IsInsideAuraObject(obj, aggressive)
                or (aggressive and HasDracoKeyword(obj.Name))
        end
        if obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") or obj:IsA("ScreenGui") then
            return dracoRelated or IsInsideAuraObject(obj, aggressive)
                or (aggressive and HasDracoKeyword(obj.Name))
        end
        return false
    end
    local function HideDracoVisual(obj)
        if not obj then return end
        DracoHidden[obj] = true
        pcall(function()
            if obj:IsA("BasePart") then
                obj.LocalTransparencyModifier = 1
                obj.Transparency = 1
                obj.CanCollide = false
                obj.CanTouch = false
                obj.CanQuery = false
                obj.CastShadow = false
            elseif obj:IsA("ParticleEmitter") then
                obj.Enabled = false
                obj.Rate = 0
                obj.Lifetime = NumberRange.new(0)
            elseif obj:IsA("Sparkles") or obj:IsA("Fire") or obj:IsA("Smoke")
                or obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight")
                or obj:IsA("Highlight") then
                obj.Enabled = false
            elseif obj:IsA("Beam") or obj:IsA("Trail") then
                obj.Enabled = false
                pcall(function() obj.Lifetime = 0 end)
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = 1
            elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") or obj:IsA("ScreenGui") then
                obj.Enabled = false
            end
        end)
    end
    local function HideDracoTree(root, aggressive)
        if not root or not _G.RemoveDracoAura then return end
        if ShouldHideDracoObject(root, aggressive) then
            HideDracoVisual(root)
        end
        local canHaveChildren = root:IsA("Model") or root:IsA("Folder")
            or root:IsA("BasePart") or root:IsA("Attachment")
        if not canHaveChildren then return end
        for _, obj in ipairs(root:GetDescendants()) do
            if not _G.RemoveDracoAura then return end
            if ShouldHideDracoObject(obj, aggressive) then
                HideDracoVisual(obj)
            end
        end
    end
    local function CleanDracoRoot(root, aggressive)
        HideDracoTree(root, aggressive)
    end
    local function CleanDracoCharacter(char, aggressive)
        HideDracoTree(char, aggressive)
    end
    local function NearDracoV4(position)
        for _, player in ipairs(Players:GetPlayers()) do
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp and HasDracoV4Marker(char) then
                if (hrp.Position - position).Magnitude <= 120 then
                    return true
                end
            end
        end
        return false
    end
    local function IsSeparateAuraPart(obj)
        if not IsLooseAuraPart(obj) then return false end
        if obj.Transparency < 0.2 then return false end
        if FindDracoCharacter(obj) then return false end
        return NearDracoV4(obj.Position)
    end
    local function CleanWorkspaceDracoNames()
        if not _G.RemoveDracoAura then return end
        for _, obj in ipairs(workspace:GetChildren()) do
            if not _G.RemoveDracoAura then return end
            local isPlayerCharacter = obj:IsA("Model") and Players:GetPlayerFromCharacter(obj) ~= nil
            if not isPlayerCharacter and IsDracoName(obj.Name) then
                pcall(CleanDracoRoot, obj, true)
            end
        end
    end
    local function NearestPartOf(obj)
        local node = obj
        for _ = 1, 8 do
            if not node then return nil end
            if node:IsA("BasePart") then return node end
            node = node.Parent
        end
        return nil
    end
    local function ProcessDracoAuraQueue()
        if DracoAuraProcessing then return end
        DracoAuraProcessing = true
        task.spawn(function()
            while #DracoAuraQueue > 0 do
                local batch = DracoAuraQueue
                DracoAuraQueue = {}
                for _, item in ipairs(batch) do
                    DracoAuraQueued[item] = nil
                    if _G.RemoveDracoAura and item.Parent then
                        pcall(function()
                            if IsDracoName(item.Name) then
                                HideDracoTree(item, true)
                                return
                            end
                            if HasDracoAncestor(item) then
                                HideDracoTree(item, true)
                                return
                            end
                            local char = FindDracoCharacter(item)
                            if char and HasDracoV4Marker(char) then
                                HideDracoTree(item, HasActiveDracoAura(char))
                                return
                            end
                            local part = NearestPartOf(item)
                            if part and NearDracoV4(part.Position)
                                and (IsOrangeAuraPart(part) or IsSeparateAuraPart(part)) then
                                HideDracoTree(part, true)
                            end
                        end)
                    end
                end
                task.wait()
            end
            DracoAuraProcessing = false
        end)
    end
    local function QueueDracoAura(obj)
        if not _G.RemoveDracoAura or not obj or DracoAuraQueued[obj] then return end
        if not IsDracoName(obj.Name) then
            if IsFPSBoostMapObject(obj) then return end
            local visual = obj:IsA("BasePart") or IsAuraVisualEffect(obj)
                or obj:IsA("Decal") or obj:IsA("Texture")
                or obj:IsA("BillboardGui") or obj:IsA("SurfaceGui")
                or obj:IsA("Model") or obj:IsA("Folder") or obj:IsA("Attachment")
            if not visual then return end
        end
        DracoAuraQueued[obj] = true
        DracoAuraQueue[#DracoAuraQueue + 1] = obj
        ProcessDracoAuraQueue()
    end
    local function HasAnyDracoMarker()
        for _, player in ipairs(Players:GetPlayers()) do
            if HasDracoV4Marker(player.Character) then
                return true
            end
        end
        return false
    end
    local function ScanWorkspaceDraco()
        if DracoAuraScanning or not _G.RemoveDracoAura or not HasAnyDracoMarker() then return end
        DracoAuraScanning = true
        task.spawn(function()
            local scanned = 0
            for _, obj in ipairs(workspace:GetDescendants()) do
                if not _G.RemoveDracoAura then break end
                pcall(function()
                    if IsDracoName(obj.Name) then
                        local isPlayerCharacter = obj:IsA("Model") and Players:GetPlayerFromCharacter(obj) ~= nil
                        if not isPlayerCharacter then
                            HideDracoTree(obj, true)
                        end
                    elseif obj:IsA("BasePart") and NearDracoV4(obj.Position)
                        and (IsOrangeAuraPart(obj) or IsSeparateAuraPart(obj)) then
                        HideDracoTree(obj, true)
                    end
                end)
                scanned = scanned + 1
                if scanned % 500 == 0 then task.wait() end
            end
            DracoAuraScanning = false
        end)
    end
    local function InstallDracoAuraHooks()
        if DracoAuraHooked then return end
        DracoAuraHooked = true
        pcall(function() workspace.DescendantAdded:Connect(QueueDracoAura) end)
        task.spawn(function()
            while true do
                task.wait(2)
                if _G.RemoveDracoAura then
                    for _, player in ipairs(Players:GetPlayers()) do
                        local char = player.Character
                        if char then
                            if HasActiveDracoAura(char) then
                                pcall(CleanDracoCharacter, char, true)
                            elseif HasDracoV4Marker(char) then
                                pcall(CleanDracoCharacter, char, false)
                            end
                        end
                    end
                    pcall(CleanWorkspaceDracoNames)
                    for obj in pairs(DracoHidden) do
                        if not obj.Parent then
                            DracoHidden[obj] = nil
                        else
                            pcall(HideDracoVisual, obj)
                        end
                    end
                end
            end
        end)
    end
    PerformanceAPI.ApplyDracoAuraRemoval = function()
        InstallDracoAuraHooks()
        if not _G.RemoveDracoAura then return end
        for _, player in ipairs(Players:GetPlayers()) do
            local char = player.Character
            if char then
                if HasActiveDracoAura(char) then
                    pcall(CleanDracoCharacter, char, true)
                elseif HasDracoV4Marker(char) then
                    pcall(CleanDracoCharacter, char, false)
                end
            end
        end
        pcall(CleanWorkspaceDracoNames)
        ScanWorkspaceDraco()
    end
