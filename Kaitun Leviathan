                    _G.AutoCraftScrolls = true
                    if _G.Abyss_AutoCraftScrollsToggle then
                        pcall(function()
                            _G.Abyss_AutoCraftScrollsToggle:SetValue(true)
                        end)
                    else
                        SaveConfig()
                    end
                end
                return
            end
        elseif os.clock() - pending.At < 15 then
            CraftStatus = T("craft.unlock.wait") .. ": " .. pending.Label
            return
        else
            CraftQualityList.Pending = nil
            if (pending.Key == "MythicalScroll" or pending.Key == "LegendaryScroll") and pending.Accepted then
                if bothSelected and pending.Key == "MythicalScroll"
                    and CraftQualityList.UnlockStage ~= "Legendary" then
                    CraftQualityList.UnlockStage = "Legendary"
                    CraftStatus = TranslateStatus("Mythical Scroll not confirmed; continuing with Legendary Scroll")
                    return
                end
                StopAutoUnlockMythical("craft.unlock.unknown")
                return
            end
        end
    end
