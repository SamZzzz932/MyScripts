            for Key, Flag in pairs(RawSelection) do
                if (type(Key) == "number" and type(Flag) == "string" and Flag ~= "")
                    or (type(Key) == "string" and (Flag == true or (type(Flag) == "string" and Flag ~= ""))) then
                    return {}
