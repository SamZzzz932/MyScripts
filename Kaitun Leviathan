            local reaperCurseKey = EnchantNameKey("curse of the reaper")
            local selected = EnchantSelectedKeys()
            local hasNonReaper = false
            for key in pairs(selected) do
                if key ~= reaperKey and key ~= reaperCurseKey then
                    hasNonReaper = true
                end
            end
            local present, required, satisfied = {}, 0, 0
            for group, keys in pairs(groups) do
                if next(keys) ~= nil then
                    required = required + 1
                    present[group] = false
                end
            end
            local anyHit, nonReaperHit = false, false
            for _, modifier in pairs(modifiers or {}) do
                if type(modifier) == "table" and modifier.Name then
                    local name = tostring(modifier.Name)
                    parts[#parts + 1] = name .. (modifier.Level and (" " .. tostring(modifier.Level)) or "")
