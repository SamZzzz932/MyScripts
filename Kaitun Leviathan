            elseif obj:IsA("Beam") or obj:IsA("Highlight") then
                obj.Enabled = false
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = 1
            elseif obj:IsA("Fire") or obj:IsA("Smoke")
                or obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
                obj.Enabled = false
            elseif obj:IsA("Explosion") then
                obj.BlastPressure, obj.BlastRadius = 1, 1
            elseif obj:IsA("BasePart") or obj:IsA("UnionOperation")
                or obj:IsA("CornerWedgePart") or obj:IsA("TrussPart") then
                obj.Reflectance = 0
