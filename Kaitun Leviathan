    local unlockCount = CraftQualityList.GetCount(Prog, Etc, unlockTarget)
    local unlockCap = (unlockTarget == "LegendaryScroll") and 20 or 10
    if unlockCount >= unlockCap then
        if _G.CraftQuality == AUTO_CRAFT_BOTH_LABEL and unlockTarget == "MythicalScroll" then
            CraftQualityList.UnlockStage = "Legendary"
